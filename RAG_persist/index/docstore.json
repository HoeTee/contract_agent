2\r\n\r\n\u5730\u5740\uff1a\u676d\u5dde\u5e02\u5e86\u6625\u4e1c\u8def3\u53f7\r\n\r\n\u8054\u7cfb\u4eba\uff1a\u94b1\u9896\r\n\r\n\u7535\u8bdd\uff1a0571-86002084\r\n\r\n\u7535\u5b50\u90ae\u7bb1\uff1aqiany@srrsh.com\r\n\r\n\u4e59\u65b9\uff1a\u6d59\u6c5f\u519c\u6751\u5546\u4e1a\u8054\u5408\u94f6\u884c\u80a1\u4efd\u6709\u9650\u516c\u53f8\r\n\r\n\u5730\u5740\uff1a\u676d\u5dde\u5e02\u79cb\u6d9b\u8def660\u53f7\r\n\r\n\u8054\u7cfb\u4eba\uff1a\u80e1\u5a77\u5a77\r\n\r\n\u7535\u8bdd\uff1a0571-56029332\r\n\r\n\u7535\u5b50\u90ae\u7bb1\uff1ahtt@zjrcu.com\r\n\r\n\u5408\u4f5c\u76ee\u7684\r\n\r\n\u6d59\u6c5f\u5927\u5b66\u533b\u5b66\u9662\u9644\u5c5e\u90b5\u9038\u592b\u533b\u9662\u4e0e\u6d59\u6c5f\u519c\u6751\u5546\u4e1a\u8054\u5408\u94f6\u884c\u80a1\u4efd\u6709\u9650\u516c\u53f8(\u4ee5\u4e0b\u7b80\u79f0\uff1a\u6d59\u6c5f\u519c\u5546\u8054\u5408\u94f6\u884c)\u8fdb\u4e00\u6b65\u62d3\u5c55\u53cc\u65b9\u7684\u5408\u4f5c\u9886\u57df\uff0c\u5e76\u4f7f\u4e4b\u6df1\u5316\u5efa\u7acb\u65b0\u578b\u6218\u7565\u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\uff0c\u63a8\u52a8\u53cc\u65b9\u4e1a\u52a1\u7684\u5171\u540c\u53d1\u5c55\uff0c\u7ecf\u53cb\u597d\u534f\u5546\uff0c\u672c\u7740\u4e92\u60e0\u4e92\u5229\u7684\u539f\u5219\uff0c\u52a0\u5f3a\u5f7c\u6b64\u7684\u5408\u4f5c\u5173\u7cfb\u3002\u8fbe\u6210\u4ee5\u4e0b\u534f\u8bae\uff1a\r\n\r\n\u670d\u52a1\u5bf9\u8c61\r\n\r\n\u6d59\u6c5f\u519c\u5546\u8054\u5408\u94f6\u884c\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u8d35\u5bbe\u5ba2\u6237\uff0c\u5305\u62ec\uff1a\u6d59\u6c5f\u519c\u5546\u8054\u5408\u94f6\u884c\u53ca\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u8ba4\u5b9a\u4e3a\u4f18\u8d28\u5ba2\u6237\u7684\u4e30\u6536\u8d37\uff08\u501f\uff09\u8bb0\u5361\u6301\u5361\u4eba\u53ca\u4e30\u6536\u4e92\u8054APP\u7b49\u6e20\u9053\u6743\u76ca\u4e8c\u7ef4\u7801\u7684\u6301\u6709\u4eba\u3002\r\n\r\n\u5ba2\u6237\u8eab\u4efd\u786e\u8ba4\r\n\r\n\u5ba2\u6237\u5728\u670d\u52a1\u73b0\u573a(\u6d59\u6c5f\u5927\u5b66\u533b\u5b66\u9662\u9644\u5c5e\u90b5\u9038\u592b\u533b\u9662\u7279\u9700\u95e8\u8bca)\u51fa\u793a\u4e30\u6536\u8d37\uff08\u501f\uff09\u8bb0\u5361\u6216\u6743\u76ca\u4e8c\u7ef4\u7801\uff0c\u901a\u8fc7POS\u673a\u5237\u5361\u6216\u626b\u7801\u9a8c\u8bc1\u5373\u53ef\uff0c\u4e00\u5f20\u5361\u6216\u4e00\u4e2a\u6743\u76ca\u4e8c\u7ef4\u7801\u5bf9\u5e94\u4e00\u4e2a\u5ba2\u6237\u3002\u533b\u9662\u5de5\u4f5c\u4eba\u5458\u7ed9\u4e88\u786e\u8ba4\u5ba2\u6237\u8eab\u4efd\u540e\uff0c\u5219\u53ef\u7ed9\u4e88\u4eab\u53d7\u8d35\u5bbe\u7ea7\u670d\u52a1\u5f85\u9047\u3002\r\n\r\n\u56db\u3001\u5177\u4f53\u670d\u52a1\u6807\u51c6\r\n\r\n\u670d\u52a1\u7ed3\u7b97\u5185\u5bb9\r\n\r\n\uff08\u4e00\uff09\u670d\u52a1\u65f6\u6548\uff1a\u5408\u4f5c\u671f\u9650\u4e3a2026\u5e741\u67081\u65e5\u81f32028\u5e7412\u670831\u65e5\u3002\r\n\r\n\uff08\u4e8c\uff09\u901a\u9053\u8d39\u7ed3\u7b97\uff1a\r\n\r\n1. \u8d35\u5bbe\u533b\u7597\u5065\u5eb7\u670d\u52a1\u901a\u9053\u8d39\u4e3a\u00a5432000.00\u5143(\u542b\u7a0e\uff0c\u4e0d\u5305\u542b\u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39),\u5927\u5199\u91d1\u989d\uff1a\u4eba\u6c11\u5e01\u8086\u62fe\u53c1\u4e07\u8d30\u4edf\u5143\u6574\u3002\r\n\r\n2. \u8d35\u5bbe\u533b\u7597\u5065\u5eb7\u670d\u52a1\u901a\u9053\u8d39\u7684\u5206\u6279\u4ed8\u6b3e\u65f6\u95f4\u53ca\u91d1\u989d\u5982\u4e0b\uff1a\r\n\r\n\uff081\uff09\u7b2c\u4e00\u6b21\u4ed8\u6b3e\u65f6\u95f4\u4e3a2026\u5e746\u670830\u65e5\uff0c\u7532\u65b9\u5411\u4e59\u65b9\u652f\u4ed82026\u5e74\u8d35\u5bbe\u533b\u7597\u5065\u5eb7\u670d\u52a1\u901a\u9053\u8d39\uff0c\u5c0f\u5199:\uffe5144000.00\u5143(\u5927\u5199: \u4eba\u6c11\u5e01\u62fe\u4e07\u8086\u4edf\u8086\u4f70\u5143\u6574)\u3002\r\n\r\n\uff082\uff09\u7b2c\u4e8c\u6b21\u4ed8\u6b3e\u65f6\u95f4\u4e3a2027\u5e746\u670830\u65e5\uff0c\u7532\u65b9\u5411\u4e59\u65b9\u652f\u4ed82027\u5e74\u8d35\u5bbe\u533b\u7597\u5065\u5eb7\u670d\u52a1\u901a\u9053\u8d39\uff0c\u5c0f\u5199:\uffe5144000.00\u5143(\u5927\u5199: \u4eba\u6c11\u5e01\u62fe\u4e07\u8086\u4edf\u8086\u4f70\u5143\u6574)\u3002\r\n\r\n\uff083\uff09\u7b2c\u4e09\u6b21\u4ed8\u6b3e\u65f6\u95f4\u4e3a2028\u5e746\u670830\u65e5\uff0c\u7532\u65b9\u5411\u4e59\u65b9\u652f\u4ed82028\u5e74\u8d35\u5bbe\u533b\u7597\u5065\u5eb7\u670d\u52a1\u901a\u9053\u8d39\uff0c\u5c0f\u5199:\uffe5144000.00\u5143(\u5927\u5199: \u4eba\u6c11\u5e01\u62fe\u4e07\u8086\u4edf\u8086\u4f70\u5143\u6574)\u3002\r\n\r\n3.\u5f00\u7968\u5185\u5bb9\uff1a\u672c\u5408\u4f5c\u534f\u8bae\u5185\uff0c\u7532\u65b9\u5f00\u5177\u7684\u53d1\u7968\u9700\u4e3a\u7b26\u5408\u56fd\u5bb6\u89c4\u5b9a\u7684\u4e13\u7968\uff0c\u5f00\u7968\u5185\u5bb9\uff1a\u670d\u52a1\u8d39\u3002\r\n\r\n4.", "mimetype": "text/plain", "start_char_idx": 1, "end_char_idx": 1030, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "743d6c5b-abe5-4188-9eb1-874c2091d7bc": {"__data__": {"id_": "743d6c5b-abe5-4188-9eb1-874c2091d7bc", "embedding": null, "metadata": {"file_path": "C:\\Users\\18014\\AppData\\Local\\Temp\\tmp50luwpjd.md", "file_name": "tmp50luwpjd.md", "file_size": 7096, "creation_date": "2026-03-30", "last_modified_date": "2026-03-30", "header_path": " / "}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "fb8ac6bf-30d6-4ddc-a4ab-bd39bde15f4d", "node_type": "4", "metadata": {"file_path": "C:\\Users\\18014\\AppData\\Local\\Temp\\tmp50luwpjd.md", "file_name": "tmp50luwpjd.md", "file_size": 7096, "creation_date": "2026-03-30", "last_modified_date": "2026-03-30"}, "hash": "d00c93ccc434f63fe5fbc4d7ed9e4a6baad43d81c742179a6307b005b5eb4e34", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "62693e7c-f492-4907-9e3b-bd7e58911bc0", "node_type": "1", "metadata": {}, "hash": "9371a49db1f59ec2680f7ca018328fd97f39bc750ada9b73e3387fb85013aabf", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "f75c4352-65ae-4b43-ae1c-a7dbfb585fd4", "node_type": "1", "metadata": {}, "hash": "f41364cc602de395ae4b68f3bafc1db3d9ca6648b38348f833dd4deea26c46c9", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u4e59\u65b9\u6536\u5230\u7532\u65b9\u5f00\u51fa\u589e\u503c\u7a0e\u4e13\u7528\u53d1\u7968\u786e\u8ba4\u65e0\u8bef\u540e20\u4e2a\u5de5\u4f5c\u65e5\u5185\uff0c\u5411\u7532\u65b9\u652f\u4ed8\u53d1\u7968\u91d1\u989d\u7684\u6b3e\u9879\u5230\u672c\u5408\u540c\u6307\u5b9a\u7684\u7532\u65b9\u8d26\u6237\u3002\r\n\r\n\uff081\uff09\u7532\u65b9\u8d26\u6237\u5982\u4e0b\uff1a\r\n\r\n\u6237\u540d\uff1a\u6d59\u6c5f\u5927\u5b66\u533b\u5b66\u9662\u9644\u5c5e\u90b5\u9038\u592b\u533b\u9662\r\n\r\n\u8d26\u53f7\uff1a1202020709014428670\r\n\r\n\u5f00\u6237\u884c\uff1a\u676d\u5dde\u5e02\u5de5\u884c\u89e3\u653e\u8def\u652f\u884c\r\n\r\n\uff082\uff09\u7532\u65b9\u7684\u4e0a\u8ff0\u8d26\u6237\u4fe1\u606f\u5982\u6709\u53d8\u66f4\uff0c\u7532\u65b9\u5e94\u5f53\u5728\u6b63\u5f0f\u5f00\u7968\u524d15\u4e2a\u5de5\u4f5c\u65e5\u4ee5\u4e66\u9762\u6587\u4ef6\u90ae\u5bc4(\u4e59\u65b9\u8054\u7cfb\u4eba\u5730\u5740)\u6216\u7535\u5b50\u90ae\u4ef6(\u4e59\u65b9\u8054\u7cfb\u4eba\u90ae\u7bb1)\u5f62\u5f0f\u901a\u77e5\u4e59\u65b9\uff0c\u5426\u5219\u56e0\u6b64\u5bfc\u81f4\u7684\u4e00\u5207\u540e\u679c\u7531\u7532\u65b9\u81ea\u884c\u627f\u62c5\u3002\r\n\r\n\uff08\u4e09\uff09\u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u7ed3\u7b97\uff1a\r\n\r\n1. \u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u5355\u4ef7\uff1a\u00a5100.00\u5143/\u4eba\u6b21(\u542b\u7a0e)\uff0c\u5927\u5199\u91d1\u989d\uff1a\u4eba\u6c11\u5e01\u58f9\u4f70\u5143\u6574\u3002\r\n\r\n2. \u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u7ed3\u7b97\u65b9\u5f0f\uff1a\u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u91c7\u7528\u5e74\u7ed3\u5236\uff0c\u5373\u6b21\u5e74\u7ed3\u7b97\u4e0a\u4e00\u5e74\u5ea6\u7684\u6d59\u6c5f\u519c\u5546\u94f6\u884c\u7cfb\u7edf\u8d35\u5bbe\u5ba2\u6237\u8bca\u7597\u8d39\uff0c\u8d39\u7528\u7531\u4e59\u65b9\u8f96\u5c5e\u5404\u519c\u5546\u94f6\u884c\u6309\u5b9e\u9645\u4f7f\u7528\u91cf\u7ed3\u7b97\u3002\r\n\r\n3. \u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u6838\u5bf9\uff1a\u7532\u4e59\u53cc\u65b9\u6838\u5bf9\u4e0a\u4e00\u5e74\u5ea6\u5c31\u8bca\u8d35\u5bbe\u5ba2\u6237\u4eba\u6570\uff0c\u5982\u4e59\u65b9\u5bf9\u7532\u65b9\u767b\u8bb0\u7684\u8d35\u5bbe\u5ba2\u6237\u5c31\u8bca\u4eba\u6570\u6709\u5f02\u8bae\u7684\uff0c\u53ef\u4ee5\u4e0e\u7532\u65b9\u8fdb\u884c\u534f\u5546\u786e\u5b9a\uff0c\u534f\u5546\u4e0d\u4e00\u81f4\u7684\uff0c\u6309\u7167\u94f6\u884c\u65b9\u5b9e\u9645POS\u673a\u6216\u6743\u76ca\u4e8c\u7ef4\u7801\u6838\u9500\u8bb0\u5f55\u4e3a\u51c6\u3002\r\n\r\n4. \u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u5f00\u7968\u53ca\u7ed3\u7b97\uff1a\u7532\u4e59\u53cc\u65b9\u5c31\u7279\u9700\u95e8\u8bca\u5c31\u8bca\u4eba\u6570\u8fbe\u6210\u4e00\u81f4\u540e\uff0c\u7532\u65b9\u5411\u4e59\u65b9\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u5f00\u5177\u533b\u9662\u6b63\u89c4\u95e8\u8bca\u53d1\u7968\uff0c\u5e76\u901a\u77e5\u4e59\u65b9\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u7532\u65b9\u8fdb\u884c\u7ed3\u7b97\u3002\u7ed3\u7b97\u65b9\u5f0f\u53ca\u5f00\u7968\u5185\u5bb9\u9075\u5faa\u672c\u5408\u540c\u534f\u8bae\u7ea6\u5b9a(\u53c2\u89c1\u9644\u4ef6\u300a\u6d59\u6c5f\u519c\u5546\u8054\u5408\u94f6\u884c\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u5f00\u7968\u4fe1\u606f\u6e05\u5355\u300b),\u4e59\u65b9\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u5728\u6536\u5230\u53d1\u7968\u540e\u768420\u4e2a\u5de5\u4f5c\u65e5\u5185\u4ed8\u6e05\u76f8\u5e94\u8d39\u7528\u3002\r\n\r\n\u516d\u3001\u53cc\u65b9\u7684\u8d23\u4efb\u548c\u4e49\u52a1\r\n\r\n1.\u7532\u65b9\u8d23\u4efb\u4e0e\u4e49\u52a1\uff1a\r\n\r\n\uff081\uff09\u4e3a\u4e59\u65b9\u8d35\u5bbe\u5ba2\u6237\u63d0\u4f9b\u4e0a\u8ff0\u8d35\u5bbe\u4f18\u8d28\u3001\u4f18\u60e0\u3001\u4f18\u5148\u3001\u65b9\u4fbf\u7684\u670d\u52a1\u5185\u5bb9\u3002\r\n\r\n\uff082\uff09\u7532\u65b9\u5728\u7279\u9700\u95e8\u8bca\u63d0\u4f9b\u663e\u8457\u4f4d\u7f6e\u5c55\u793a\u4e59\u65b9\u5355\u4f4dLOGO\u3002\r\n\r\n\uff083\uff09\u7279\u9700\u95e8\u8bca\u7531\u526f\u4e3b\u4efb\u804c\u79f0\u53ca\u4ee5\u4e0a\u7684\u533b\u751f\u5750\u8bca\u3002\r\n\r\n\uff084\uff09\u8d35\u5bbe\u5ba2\u6237\u5c31\u8bca\u524d\uff0c\u7532\u65b9\u5e94\u901a\u8fc7POS\u673a\u5237\u5361\u9a8c\u8bc1\u4e30\u6536\u8d37\uff08\u501f\uff09\u8bb0\u5361\u6216\u6743\u76ca\u4e8c\u7ef4\u7801\uff0c\u5e76\u767b\u8bb0\u3001\u8bb0\u5f55\u5ba2\u6237\u59d3\u540d\u3001\u5361\u53f7/\u5238\u7801\u53f7\u53ca\u5c31\u8bca\u65e5\u671f\u7b49\u4fe1\u606f\u4fbf\u4e8e\u53cc\u65b9\u7ed3\u7b97\u3002\r\n\r\n\uff085\uff09\u7532\u65b9\u5728\u7ed9\u4e59\u65b9\u7684\u5ba2\u6237\u8fdb\u884c\u68c0\u67e5\u3001\u6cbb\u7597\u3001\u4f4f\u9662\u7b49\u670d\u52a1\u65f6\uff0c\u6309\u6d59\u6c5f\u7701\u7269\u4ef7\u5c40\u5907\u6848\u7684\u7279\u9700\u670d\u52a1\u6536\u8d39\u6807\u51c6\u6536\u53d6\u7279\u9700\u670d\u52a1\u8d39\uff0c\u6709\u5173\u6536\u8d39\u7684\u4e89\u8bae\u7531\u53cc\u65b9\u534f\u5546\u89e3\u51b3\u3002\r\n\r\n\uff086\uff09\u7532\u65b9\u5e94\u505a\u597d\u4e59\u65b9\u8d35\u5bbe\u5ba2\u6237\u7684\u5c31\u8bca\u4fe1\u606f\u8bb0\u5f55\uff0c\u5c31\u8bca\u4fe1\u606f\u5305\u62ec\uff1a\u8d35\u5bbe\u5ba2\u6237\u59d3\u540d\u3001\u5361\u53f7\u53ca\u5c31\u8bca\u65e5\u671f\u7b49\u5185\u5bb9\u3002", "mimetype": "text/plain", "start_char_idx": 1031, "end_char_idx": 1973, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "f75c4352-65ae-4b43-ae1c-a7dbfb585fd4": {"__data__": {"id_": "f75c4352-65ae-4b43-ae1c-a7dbfb585fd4", "embedding": null, "metadata": {"file_path": "C:\\Users\\18014\\AppData\\Local\\Temp\\tmp50luwpjd.md", "file_name": "tmp50luwpjd.md", "file_size": 7096, "creation_date": "2026-03-30", "last_modified_date": "2026-03-30", "header_path": " / "}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "fb8ac6bf-30d6-4ddc-a4ab-bd39bde15f4d", "node_type": "4", "metadata": {"file_path": "C:\\Users\\18014\\AppData\\Local\\Temp\\tmp50luwpjd.md", "file_name": "tmp50luwpjd.md", "file_size": 7096, "creation_date": "2026-03-30", "last_modified_date": "2026-03-30"}, "hash": "d00c93ccc434f63fe5fbc4d7ed9e4a6baad43d81c742179a6307b005b5eb4e34", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "743d6c5b-abe5-4188-9eb1-874c2091d7bc", "node_type": "1", "metadata": {}, "hash": "93af022520fa9b0059b8fcb017f392c3028ccc9c949bd540556d2ce0f2bacda1", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\uff085\uff09\u7532\u65b9\u5728\u7ed9\u4e59\u65b9\u7684\u5ba2\u6237\u8fdb\u884c\u68c0\u67e5\u3001\u6cbb\u7597\u3001\u4f4f\u9662\u7b49\u670d\u52a1\u65f6\uff0c\u6309\u6d59\u6c5f\u7701\u7269\u4ef7\u5c40\u5907\u6848\u7684\u7279\u9700\u670d\u52a1\u6536\u8d39\u6807\u51c6\u6536\u53d6\u7279\u9700\u670d\u52a1\u8d39\uff0c\u6709\u5173\u6536\u8d39\u7684\u4e89\u8bae\u7531\u53cc\u65b9\u534f\u5546\u89e3\u51b3\u3002\r\n\r\n\uff086\uff09\u7532\u65b9\u5e94\u505a\u597d\u4e59\u65b9\u8d35\u5bbe\u5ba2\u6237\u7684\u5c31\u8bca\u4fe1\u606f\u8bb0\u5f55\uff0c\u5c31\u8bca\u4fe1\u606f\u5305\u62ec\uff1a\u8d35\u5bbe\u5ba2\u6237\u59d3\u540d\u3001\u5361\u53f7\u53ca\u5c31\u8bca\u65e5\u671f\u7b49\u5185\u5bb9\u3002\u7532\u65b9\u6309\u6708\u8fdb\u884c\u8d35\u5bbe\u5ba2\u6237\u5c31\u8bca\u4fe1\u606f\u7edf\u8ba1\uff0c\u5e76\u5c06\u660e\u7ec6\u6c47\u603b\u4ee5\u5fae\u4fe1\u6216\u7535\u5b50\u90ae\u4ef6(\u4e59\u65b9\u8054\u7cfb\u4eba\u90ae\u7bb1)\u7684\u5f62\u5f0f\u63d0\u4ea4\u81f3\u4e59\u65b9\u786e\u8ba4\uff0c\u53cc\u65b9\u6838\u5bf9\u786e\u8ba4\u65e0\u8bef\u540e\uff0c\u5c06\u6bcf\u6708\u4ea7\u751f\u7684\u5c31\u8bca\u8d39\u7528\u8ba1\u5165\u5e74\u5ea6\u7279\u9700\u95e8\u8bca\u8bca\u7597\u8d39\u3002\r\n\r\n2.\u4e59\u65b9\u8d23\u4efb\u548c\u4e49\u52a1\r\n\r\n\uff081\uff09\u4e59\u65b9\u5411\u7532\u65b9\u514d\u8d39\u63d0\u4f9b\u5237\u5361\u673a\u5177\uff0c\u8d35\u5bbe\u6837\u5361\u4ee5\u4f9b\u7532\u65b9\u4e3a\u4e59\u65b9\u5ba2\u6237\u63d0\u4f9b\u670d\u52a1\u65f6\u7684\u8eab\u4efd\u786e\u8ba4\u3002\r\n\r\n\uff082\uff09\u4e59\u65b9\u9700\u8981\u5ba3\u4f20\u6216\u4ecb\u7ecd\u76f8\u5173\u7684\u4e1a\u52a1\u8d44\u6599\uff0c\u9700\u8981\u4e8b\u5148\u4e0e\u7532\u65b9\u6c9f\u901a\uff0c\u5e76\u5f81\u5f97\u5bf9\u65b9\u7684\u540c\u610f\u3002\r\n\r\n\u4e03\u3001\u7279\u9700\u95e8\u8bca\u5f00\u653e\u65f6\u95f4\r\n\r\n1.\u5de5\u4f5c\u65e5\u6bcf\u5929\u4e0a\u53488:00\u81f312:00,\u4e0b\u534813:30\u81f317:00\u3002\u5468\u672b\u4e0a\u53488:00\u81f312:00\u3002\r\n\r\n2.\u6025\u8bca\u60a3\u8005\u6309\u533b\u9662\u5e38\u89c4\u6025\u8bca\u6d41\u7a0b\u3002\r\n\r\n\u516b\u3001\u4f18\u5148\u670d\u52a1\u539f\u5219\r\n\r\n\u57fa\u4e8e\u533b\u9662\u670d\u52a1\u7684\u7279\u6b8a\u6027\uff0c\u7532\u65b9\u63d0\u4f9b\u7684\u4f18\u5148\u670d\u52a1\u4e5f\u6709\u4e00\u5b9a\u7684\u539f\u5219\u3002\u7532\u65b9\u63d0\u51fa\u7684\u4f18\u5148\u6982\u5ff5\uff0c\u662f\u6307\u7b49\u5f85\u6cbb\u7597\u7684\u75c5\u4eba\u4e2d\uff0c\u4e0d\u7ba1\u662f\u5426\u6709\u4e59\u65b9\u8d35\u5bbe\u5ba2\u6237\u75c5\u4eba\uff0c\u5148\u4ee5\u75c5\u60c5\u7d27\u6025\u7a0b\u5ea6\u786e\u5b9a\u4f18\u5148\u7ea7\uff0c\u5982\u540c\u79cd\u7d27\u6025\u7a0b\u5ea6\uff0c\u5219\u4e59\u65b9\u8d35\u5bbe\u5ba2\u6237\u75c5\u4eba\u4f18\u5148\u6cbb\u7597\u3002\r\n\r\n\u4e5d\u3001\u534f\u8bae\u6709\u6548\u65f6\u95f4\u53ca\u76f8\u5173\u4e8b\u9879\r\n\r\n\u534f\u8bae\u6709\u6548\u671f\u4e3a\u53c1\u5e74\u3002\u5728\u672c\u534f\u8bae\u6709\u6548\u671f\u9650\u5185\u534f\u8bae\u53cc\u65b9\u4efb\u4e00\u65b9\u8981\u6c42\u7ec8\u6b62\u672c\u534f\u8bae\u5e94\u63d0\u524d15\u5929\u4ee5\u4e66\u9762\u5f62\u5f0f\u901a\u77e5\u5bf9\u65b9\uff1b\u5c65\u884c\u671f\u95f4\u6709\u4e00\u65b9\u8fdd\u53cd\u672c\u534f\u8bae\u6761\u6b3e\uff0c\u5728\u53e6\u4e00\u65b9\u4e66\u9762\u63d0\u51fa\u4e4b\u65e5\u8d7715\u5929\u5185\u6ca1\u6709\u6539\u6b63\u7684\uff0c\u53e6\u4e00\u65b9\u6709\u6743\u5355\u65b9\u9762\u7ec8\u6b62\u672c\u534f\u8bae\uff0c\u5e76\u8981\u6c42\u8fdd\u7ea6\u65b9\u627f\u62c5\u8fdd\u7ea6\u8d23\u4efb\u3002\u7ec8\u6b62\u534f\u8bae\u540e\uff0c\u7532\u4e59\u53cc\u65b9\u4e0d\u518d\u4eab\u6709\u4e92\u76f8\u63d0\u4f9b\u7684\u4e00\u5207\u4f18\u60e0\u3002\r\n\r\n\u5341\u3001\u9644\u5219\r\n\r\n1.\u5982\u672c\u534f\u8bae\u6709\u672a\u5c3d\u4e8b\u5b9c\uff0c\u53ef\u7531\u7532\u4e59\u53cc\u65b9\u53cb\u597d\u534f\u5546\u89e3\u51b3\uff0c\u5982\u534f\u5546\u4e0d\u6210\uff0c\u5411\u4e59\u65b9\u6240\u5728\u5730\u6cd5\u9662\u63d0\u8d77\u8bc9\u8bbc\u3002\r\n\r\n2.\u672c\u534f\u8bae\u4e00\u5f0f\u8086\u4efd\uff0c\u53cc\u65b9\u5404\u6267\u8d30\u4efd\uff0c\u7ecf\u7532\u4e59\u53cc\u65b9\u6cd5\u5b9a\u4ee3\u8868\u4eba\u6216\u6388\u6743\u4ee3\u7406\u4eba\u7b7e\u5b57\u5e76\u52a0\u76d6\u516c\u7ae0\u6216\u5408\u540c\u4e13\u7528\u7ae0\u540e\u751f\u6548\u3002\r\n\r\n\u9644\u4ef6\uff1a\u6d59\u6c5f\u519c\u5546\u8054\u5408\u94f6\u884c\u53ca\u8f96\u5c5e\u519c\u5546\u94f6\u884c\u5f00\u7968\u4fe1\u606f\u6e05\u5355\r\n\r\n\u7532\u65b9\uff1a\u6d59\u6c5f\u5927\u5b66\u533b\u5b66\u9662\u9644\u5c5e\u90b5\u9038\u592b\u533b\u9662\r\n\r\n\uff08\u76d6\u7ae0\uff09\r\n\r\n\u7532\u65b9\u6388\u6743\u4ee3\u8868\r\n\r\n\u5e74      \u6708      \u65e5\r\n\r\n\u4e59\u65b9\uff1a\u6d59\u6c5f\u519c\u6751\u5546\u4e1a\u8054\u5408\u94f6\u884c\u80a1\u4efd\u6709\u9650\u516c\u53f8\r\n\r\n\uff08\u76d6\u7ae0\uff09\r\n\r\n\u4e59\u65b9\u6388\u6743\u4ee3\u8868\r\n\r\n\u5e74      \u6708     \u65e5", "mimetype": "text/plain", "start_char_idx": 1854, "end_char_idx": 2770, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/metadata": {"62693e7c-f492-4907-9e3b-bd7e58911bc0": {"doc_hash": "5e496ad3b756e3985ba592244fcd075338f6ba085a37ba38963b19d10db939c0", "ref_doc_id": "fb8ac6bf-30d6-4ddc-a4ab-bd39bde15f4d"}, "743d6c5b-abe5-4188-9eb1-874c2091d7bc": {"doc_hash": "d090234dadd3673632cef4b8062eee69a06a48cd19160b7aabc374a85aced581", "ref_doc_id": "fb8ac6bf-30d6-4ddc-a4ab-bd39bde15f4d"}, "f75c4352-65ae-4b43-ae1c-a7dbfb585fd4": {"doc_hash": "b45080d04eaf5975fdab3e461c6fc4df796379af5deee0c6995d3c629d159dff", "ref_doc_id": "fb8ac6bf-30d6-4ddc-a4ab-bd39bde15f4d"}}}
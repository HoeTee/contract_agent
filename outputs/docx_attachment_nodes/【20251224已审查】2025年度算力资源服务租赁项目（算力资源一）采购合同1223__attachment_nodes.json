              "confidence": "high",
              "reasons": [
                "local_number_sequence"
              ]
            },
            {
              "node_id": "p_0191",
              "type": "paren_cn",
              "title": "（三） 不以消费方式（包括娱乐消费、旅游、国内或国外考察等方式）贿赂贵方项目人员和管理人员。",
              "body": "",
              "start_anchor": "p_0191",

# LLM
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_NAME=qwen-plus

# EMBEDDING MODEL
EMBED_API_KEY=your_api_key_here
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_NAME=text-embedding-v4

# QWEN RERANKING MODEL
RERANK_API_KEY=your_api_key_here
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_NAME=qwen3-rerank

# NUMERIC CONFIGS
TEMPERATURE=0.0
TOP_P=0.01
SEED=42
MAX_REFLECTION_ROUNDS=3
MAX_ORCHESTRATOR_CONCURRENCY=8
MAX_API_CONCURRENT_REVIEWS=1
MAX_CONTEXT_TOKENS=120000
MAX_RESULT_TOKENS=4000
MAX_TOOL_CALLS=25

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=100
SIMILARITY_TOP_K=10
RERANK_TOP_N=5

# FILE PARSING
PARSE_FILE_WITH_MINERU=False

# WEB / CLI STORAGE
DATA_DIR=data
USERS_FILE=user_profiles/users.json
DEFAULT_CLI_USERNAME=default
SESSION_SECRET_KEY=change-this-session-secret

# FILE LOGGING
ENABLE_WORKFLOW_LOGS=False

# MINERU
MINERU_API_BASE=https://mineru.net
MINERU_API_KEY=your_api_key_here

local_tokenizers/
.cache/
*.tiktoken

# Local tool/editor state
.claude/
.codex/
.vscode/
.idea/
.codegraph/

# Generated or external root-level app/build folders
/src/
/api/
/packages/
/project_experience/
/project_intro/

# Large local archives/images
*.tar
*.tar.gz
*.zip
*.rar
image.tar


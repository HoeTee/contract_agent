data/
uploads/
docs/contracts/
docs/contract_review_criteria/
docs/reports_md/
docs/reports_docx/
docs/reports_pdf/

# Default review criteria template: keep only the committed fallback file
resources/review_criteria/*
!resources/review_criteria/.gitkeep
!resources/review_criteria/criteria.docx

# Runtime logs and indexes
logs/
*.log
RAG_persist/
docx_comment_test/
md2pdf_test/
api_review_test/
results/
.tmp_patents/
.tmp_compare/

# Python caches, environments, and build output
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.venv/
/.venv/
.venv_old/
venv/
env/
.wheel-venv/


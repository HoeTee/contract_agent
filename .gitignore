# Local secrets and deployment overrides
.env
.env.local
.env.*.local
config.yaml
docker-compose.yaml

# Runtime data, tenant profiles, and generated logs
data/*
!data/.gitkeep
!data/api/.gitkeep
!data/web/.gitkeep
logs/
uploads/
user_profiles/*
!user_profiles/.gitkeep

# Office documents, user uploads, and temporary lock files
*.doc
*.docx
*.docm
*.dot
*.dotx
*.dotm
*.pdf
~$*
~$*.doc*
.~lock.*#
*.tmp
*.bak

# Keep the committed fallback review criteria
resources/review_criteria/*
!resources/review_criteria/.gitkeep
!resources/review_criteria/criteria.docx

# Python caches, virtual environments, and build output
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Local tool and editor state
.claude/
.codex/
.vscode/
.idea/
.cache/

# Runtime indexes and generated results
RAG_persist/
results/

# Local dependency cache and large archives
/packages/
*.tar
*.tar.gz
*.zip
*.rar
image.tar

# Local notes and development-only files
/AGENTS.md
/DEPLOYMENT.md
/PLAN.md
/tests
/deploy
/docs/.$BUSINESS_USER_JOURNEY.drawio.bkp
/docs/portal
/docs/superpowers

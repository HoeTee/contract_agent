<mxfile host="app.diagrams.net" modified="2026-06-11T00:00:00.000Z" agent="Codex" version="26.0.0">
  <diagram id="business-user-journey" name="business user journey">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="合同智能审核系统使用流程" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;align=center;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="300" y="45" width="900" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="从上传合同到下载审核结果，用户只需完成几个简单步骤" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;align=center;verticalAlign=middle;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="300" y="92" width="900" height="32" as="geometry" />
        </mxCell>

        <mxCell id="start" value="开始使用" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="80" y="245" width="130" height="76" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="1&lt;br&gt;&lt;b&gt;登录系统&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;用户进入合同智能审核系统&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="210" width="170" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2&lt;br&gt;&lt;b&gt;上传合同&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;选择需要审核的合同文件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="210" width="170" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="3&lt;br&gt;&lt;b&gt;选择审查要求&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;使用默认标准，或上传本次专用要求&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="210" width="190" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="4&lt;br&gt;&lt;b&gt;等待智能审核&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;系统自动识别风险点并生成审核意见&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="210" width="190" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="5&lt;br&gt;&lt;b&gt;下载审核结果&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;获得带批注的合同文件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1230" y="210" width="190" height="145" as="geometry" />
        </mxCell>

        <mxCell id="history" value="查看历史记录&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;找回以前审核过的合同结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="管理员管理用户&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;维护账号和审查标准&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=16;fontColor=#111827;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="650" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note" value="核心交付：用户上传合同后，系统返回一份可下载的带批注合同。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=17;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
